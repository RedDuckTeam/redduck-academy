{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "node build.mjs",
    "db:auth:generate": "npx @better-auth/cli generate --output ./src/db/auth-schema.ts -y",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "db:push": "npx drizzle-kit push",
    "better-auth:migrate": "yarn dlx @better-auth/cli migrate --config ./src/lib/auth.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@privy-io/server-auth": "^1.32.5",
    "@redduck/api-contracts": "workspace:^",
    "@redduck/payload-config": "workspace:^",
    "obscenity": "^0.4.6",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/picomatch": "^4.0.3",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.2"
  }
}
