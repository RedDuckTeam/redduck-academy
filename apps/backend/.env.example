# GitHub PAT: read metadata + contents (fine-grained: Contents + Metadata read). Required at server boot.
GITHUB_TOKEN=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Dashboard → App settings → Verification key (paste the full PEM block)
PRIVY_VERIFICATION_KEY=


PORT=3001

DATABASE_URL=

# Which AI vendor backs the review subsystem: `openai` (default) or `anthropic` (Claude).
AI_PROVIDER=openai
OPENAI_API_KEY=
# Required only when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# e.g. https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public base URL for the bucket (r2.dev, custom domain, or CDN) — no trailing slash
R2_PUBLIC_URL=