DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Cloudflare R2 (S3-compatible API for uploads; R2_PUBLIC_URL for browser-facing assets)
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# e.g. https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public base URL for the bucket (r2.dev, custom domain, or CDN) — no trailing slash
R2_PUBLIC_URL=
